# MongoDB connection string (required)
MONGO_URI=

# JWT signing secret (required for login/register tokens)
JWT_SECRET=

# Server port
# PORT=5000

# Public server origin for generated upload URLs (optional).
# Leave blank to derive from the incoming request.
# SERVER_PUBLIC_URL=https://api.example.com

# Comma-separated extra allowed browser origins (optional).
# Example: https://myapp.netlify.app,https://staging.example.com
ALLOWED_ORIGINS=

# Single frontend URL (optional, merged into CORS allow list)
CLIENT_URL=
